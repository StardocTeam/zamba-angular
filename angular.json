{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "zamba": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputHashing": "all",
            "baseHref": "./",
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "node_modules/tinymce",
                "output": "assets/tinymce"
              },
              {
                "glob": "less.min.js",
                "input": "node_modules/less/dist",
                "output": "assets"
              },
              "src/assets/config.json"
            ],
            "styles": [
              "src/custom-theme.scss",
              "src/styles/theme-entry.less"
            ],
            "scripts": [
              "node_modules/sweetalert/dist/sweetalert.min.js"
            ],
            "allowedCommonJsDependencies": [
              "ajv",
              "ajv-formats",
              "html-docx-js-typescript",
              "jszip",
              "lodash",
              "mammoth",
              "mockjs",
              "file-saver",
              "extend"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/"
              ]
            }
          },
          "configurations": {
            "production": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.prod.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "rrhh": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.rrhh.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.rrhh.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "rrhh_qa": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.rrhh_qa.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.rrhh.qa.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "c": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.c.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.c.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "local": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.local.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "qa": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.qa.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
             "psprod": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.psprod.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.psprod.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
             },
             "psdesa": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.psdesa.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.psdesa.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
             },
             "ces": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.ces.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.ces.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
             },
             "cesDesa": {
              "styles": [
                "src/custom-theme.scss",
                "src/styles/theme-entry.cesDesa.less"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.ces.desa.ts"
                }
              ],
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
             }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "zamba:build",
            "proxyConfig": "proxy.conf.js",
            "servePath": "/zamba/"
          },
          "configurations": {
            "production": {
              "browserTarget": "zamba:build:production"
            },
            "development": {
              "browserTarget": "zamba:build:development"
            },
            "local": {
              "browserTarget": "zamba:build:local"
            },
            "rrhh": {
              "browserTarget": "zamba:build:rrhh"
            },
            "rrhh_qa": {
              "browserTarget": "zamba:build:rrhh_qa"
            },
            "qa": {
              "browserTarget": "zamba:build:qa"
            },
            "c": {
              "browserTarget": "zamba:build:c"
            },
            "psdesa": {
              "browserTarget": "zamba:build:psdesa"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "zamba:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "scripts": [],
            "styles": [
              "@angular/material/prebuilt-themes/deeppurple-amber.css"
            ],
            "assets": [
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "zamba:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "zamba:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "@schematics/angular",
      "zamba"
    ],
    "analytics": false
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    }
  }
}
